# Zebra — environment variables
# THE MVP IS $0. Every key below is a permanent FREE tier (see docs/plan/05 §0).
# Sprint 1 runs with NO keys at all (local mode). Add each as its sprint lands.

# --- Supabase: FREE tier (50K MAU, 500MB DB) — sprint 2 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Text generation: Google AI Studio FREE tier (Gemini Flash) — sprint 3 ---
GEMINI_API_KEY=

# --- Moderation: OpenAI Moderation endpoint is FREE — sprint 3 ---
OPENAI_API_KEY=

# --- Narration: Azure Speech FREE tier F0 (0.5M chars/mo, ur-PK voices) — sprint 2/3 ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Images: Cloudflare Workers AI FREE tier (Flux-1-schnell) — sprint 3 ---
# (Until then, the built-in SVG character cast is the $0 art system.)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Analytics: PostHog FREE tier — adult surfaces only, never Kid Mode ---
NEXT_PUBLIC_POSTHOG_KEY=
